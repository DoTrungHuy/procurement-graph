# Copy to .env in the repository root. Keep credentials local.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Enable only for model extraction. Browsing and replay do not require it.
MODEL_NETWORK_ENABLED=false
# true: the model configuration comes only from these variables and the web panel
# becomes read-only, so visitors need just APP_API_TOKEN. Set this for public deploys.
MODEL_SETTINGS_READONLY=false
# schema | direct | rag (domain-rule retrieval for new extraction)
EXTRACTION_STRATEGY=schema
# sqlite | neo4j (requires a configured and synchronized graph)
RELATION_BACKEND=sqlite
MODEL_PROFILE_PATH=
MODEL_CONCURRENCY=2
# NOTICE_CONCURRENCY=0
# Exact full-text empty-form recognition and fully explicit item tables.
EXTRACT_BLANK_TEMPLATES=true
EXTRACT_STANDARD_TABLES=true
# Experimental: falls back on empty, ambiguous or ungrounded grouped output.
EXTRACT_BATCH_ATTACHMENTS=false
MAX_LLM_CHARS=28000
DEMO_SEED=false
REFERENCE_SEED=true
APP_API_TOKEN=

# Optional Neo4j mirror; leave the URI empty to use SQLite only.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173

# Omit path overrides to use repository-relative defaults.
# OFFICIAL_DATA_DIR=
# DATABASE_PATH=
# UPLOAD_DIR=
# PARSE_CACHE_DIR=
# MODEL_RESPONSE_CACHE_DIR=
# MODEL_RESPONSE_CACHE_READ_DIRS=
# MODEL_REPLAY_CHUNKING=legacy
# MODEL_DOCUMENT_CACHE_DIR=
# MODEL_SETTINGS_PATH=
