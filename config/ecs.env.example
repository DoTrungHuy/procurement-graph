# Used by scripts/ecs.py. The initial installation generates APP_API_TOKEN.
# The model is configured here on the server: visitors only supply APP_API_TOKEN.
# MODEL_SETTINGS_READONLY locks the web panel so the model address, model name and
# key can never be read or changed from a browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_NETWORK_ENABLED=true
MODEL_SETTINGS_READONLY=true
EXTRACTION_STRATEGY=schema
RELATION_BACKEND=sqlite
DEMO_SEED=false
REFERENCE_SEED=false
MODEL_CONCURRENCY=1
PARSE_CONCURRENCY=1
APP_API_TOKEN=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173
